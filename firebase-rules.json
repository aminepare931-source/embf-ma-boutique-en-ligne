{
  "rules": {
    ".read": true,
    ".write": "auth != null",
    "products": {
      ".read": true,
      ".write": "auth != null"
    },
    "orders": {
      ".read": true,
      "$orderId": {
        ".write": "auth != null || (!data.exists() && newData.child('statut').val()=='nouveau')"
      }
    },
    "promo": {
      ".read": true,
      ".write": "auth != null"
    },
    "affilies": {
      ".read": true,
      "$affKey": {
        ".write": "auth != null || (!data.exists() && newData.child('statut').val()=='en_attente' && newData.child('gains').val()==0)",
        "clics": {
          ".write": true,
          ".validate": "newData.isNumber()"
        }
      }
    },
    "retraits": {
      ".read": true,
      "$retraitId": {
        ".write": "auth != null || (!data.exists() && newData.child('statut').val()=='en_attente')"
      }
    },
    "clicks": {
      ".read": true,
      "$clickId": {
        ".write": "!data.exists()"
      }
    }
  }
}
